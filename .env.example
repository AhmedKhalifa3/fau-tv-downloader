# ==============================================================================
# FAU.tv Downloader Configuration
# ==============================================================================

# Your FAU.tv session cookie.
# How to get it:
# 1. Log in to https://www.fau.tv in your browser.
# 2. Open Developer Tools (F12) -> Application (or Storage) -> Cookies -> https://www.fau.tv
# 3. Copy the value of 'das_videoportal_der_fau_session' and paste it below.
FAU_SESSION_COOKIE=your_das_videoportal_der_fau_session_cookie_here

# Default output directory for downloaded videos and subtitles
FAU_OUTPUT_DIR=./downloads

# Preferred stream view:
#   composite    = Combined view: lecturer + lecture slides side-by-side (recommended)
#   presentation = Fullscreen presentation slides only
#   presenter    = Lecturer camera video only
FAU_STREAM_TYPE=composite

# Automatically download subtitles (.vtt) if available (true/false)
FAU_DOWNLOAD_SUBS=true

